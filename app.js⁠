document.addEventListener('DOMContentLoaded', () => {
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('./sw.js').catch(() => {});
    }

    document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => setLanguage(btn.dataset.lang));
    });

    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    });

    document.getElementById('form-auth').addEventListener('submit', handleUnlock);

    document.getElementById('master-password').addEventListener('input', (e) => {
        evaluatePasswordStrength(e.target.value, document.getElementById('strength-bar-auth'));
    });
    document.getElementById('new-password').addEventListener('input', (e) => {
        evaluatePasswordStrength(e.target.value, document.getElementById('strength-bar-change'));
    });

    document.getElementById('btn-manual-lock').addEventListener('click', lockVault);
    document.getElementById('btn-save').addEventListener('click', saveEntry);
    document.getElementById('btn-export').addEventListener('click', exportBackup);
    document.getElementById('btn-import-trigger').addEventListener('click', () => {
        document.getElementById('import-file-input').click();
    });
    document.getElementById('import-file-input').addEventListener('change', importBackup);
    
    document.getElementById('btn-change-pwd').addEventListener('click', () => {
        document.getElementById('change-pwd-modal').style.display = 'block';
    });
    document.getElementById('btn-cancel-pwd-change').addEventListener('click', () => {
        document.getElementById('change-pwd-modal').style.display = 'none';
    });
    document.getElementById('btn-confirm-pwd-change').addEventListener('click', handleChangePassword);

    document.getElementById('search-input').addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        if (!q) {
            renderEntries(state.memoryEntries);
            return;
        }
        const filtered = state.memoryEntries.filter(item => 
            (item.title && item.title.toLowerCase().includes(q)) ||
            (item.content && item.content.toLowerCase().includes(q)) ||
            (item.mood && item.mood.toLowerCase().includes(q))
        );
        renderEntries(filtered);
    });

    ['mousemove', 'keydown', 'click', 'scroll'].forEach(evt => {
        window.addEventListener(evt, () => {
            if (state.aesKey) startIdleTimer();
        });
    });

    window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && state.aesKey) {
            lockVault();
        } else if (e.ctrlKey && e.key === 'Enter' && state.aesKey) {
            saveEntry();
        }
    });
});
