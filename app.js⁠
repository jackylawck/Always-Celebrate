// 4. 自訂無障礙 UI Toast 提示系統 (取代原生 alert)
function showToast(message, isError = false) {
    let toast = document.getElementById('custom-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.id = 'custom-toast';
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.style.cssText = `
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            z-index: 10000;
            box-shadow: 0 4px 14px rgba(0,0,0,0.4);
            transition: opacity 0.3s ease;
            text-align: center;
            max-width: 90vw;
        `;
        document.body.appendChild(toast);
    }
    toast.style.background = isError ? '#e74c3c' : '#2ecc71';
    toast.style.color = '#ffffff';
    toast.textContent = message;
    toast.style.opacity = '1';

    setTimeout(() => {
        toast.style.opacity = '0';
    }, 3000);
}

// 5. 密碼學核心引擎 (Web Crypto API)
async function deriveKeys(password, saltUint8Array) {
    const encoder = new TextEncoder();
    const baseKey = await crypto.subtle.importKey(
        'raw', encoder.encode(password), { name: 'PBKDF2' }, false, ['deriveKey']
    );
    
    const aesKey = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: saltUint8Array, iterations: PBKDF2_ITERATIONS, hash: 'SHA-256' },
        baseKey, { name: 'AES-GCM', length: 256 }, false, ['encrypt', 'decrypt']
    );

    const hmacKey = await crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt: saltUint8Array, iterations: PBKDF2_ITERATIONS, hash: 'SHA-256' },
        baseKey, { name: 'HMAC', hash: 'SHA-256', length: 256 }, false, ['sign', 'verify']
    );

    return { aesKey, hmacKey };
}

async function encryptPayload(dataObj, password) {
    const salt = crypto.getRandomValues(new Uint8Array(16));
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const { aesKey, hmacKey } = await deriveKeys(password, salt);

    const encoder = new TextEncoder();
    const dataBuffer = encoder.encode(JSON.stringify(dataObj));
    const ciphertextBuffer = await crypto.subtle.encrypt({ name: 'AES-GCM', iv: iv }, aesKey, dataBuffer);
    const ciphertextArray = new Uint8Array(ciphertextBuffer);

    const signatureBuffer = await crypto.subtle.sign('HMAC', hmacKey, ciphertextArray);

    return {
        version: "2.0",
        salt: Array.from(salt),
        iv: Array.from(iv),
        ciphertext: Array.from(ciphertextArray),
        hmac: Array.from(new Uint8Array(signatureBuffer))
    };
}

async function decryptPayload(encryptedRecord, password) {
    if (!encryptedRecord || !encryptedRecord.salt || !encryptedRecord.iv || !encryptedRecord.ciphertext) {
        throw new Error("Invalid structure");
    }
    const salt = new Uint8Array(encryptedRecord.salt);
    const iv = new Uint8Array(encryptedRecord.iv);
    const ciphertext = new Uint8Array(encryptedRecord.ciphertext);

    const { aesKey, hmacKey } = await deriveKeys(password, salt);

    if (encryptedRecord.hmac) {
        const hmacSig = new Uint8Array(encryptedRecord.hmac);
        const isValid = await crypto.subtle.verify('HMAC', hmacKey, hmacSig, ciphertext);
        if (!isValid) {
            throw new Error("HMAC Integrity verification failed: Tampered file");
        }
    }

    const decryptedBuffer = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: iv }, aesKey, ciphertext);
    return {
        entries: JSON.parse(new TextDecoder().decode(decryptedBuffer)),
        activeKey: aesKey
    };
}

// 6. 密碼強度檢測
function evaluatePasswordStrength(pwd, barElement) {
    if (!barElement) return;
    if (!pwd) { barElement.style.width = '0%'; return; }
    let score = 0;
    if (pwd.length >= 8) score += 25;
    if (pwd.length >= 12) score += 25;
    if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score += 25;
    if (/[0-9]/.test(pwd) || /[^A-Za-z0-9]/.test(pwd)) score += 25;

    barElement.style.width = score + '%';
    if (score <= 50) barElement.style.background = '#e74c3c';
    else if (score <= 75) barElement.style.background = '#f1c40f';
    else barElement.style.background = '#2ecc71';
}

// 7. 防暴力破解與會話鎖定
function checkLockout() {
    const lockoutUntil = parseInt(sessionStorage.getItem(LOCKOUT_KEY) || "0", 10);
    const now = Date.now();
    if (now < lockoutUntil) {
        const remainingSec = Math.ceil((lockoutUntil - now) / 1000);
        showAuthError(`嘗試失敗過多，冷卻中... 請等待 ${remainingSec} 秒。`);
        return true;
    }
    return false;
}

function handleFailedAttempt() {
    let attempts = parseInt(sessionStorage.getItem(ATTEMPTS_KEY) || "0", 10) + 1;
    sessionStorage.setItem(ATTEMPTS_KEY, attempts.toString());
    
    if (attempts >= 5) {
        const lockTime = Date.now() + (30 * 1000);
        sessionStorage.setItem(LOCKOUT_KEY, lockTime.toString());
        sessionStorage.setItem(ATTEMPTS_KEY, "0");
        showAuthError("連續失敗 5 次，系統已鎖定 30 秒防護！");
    } else {
        showAuthError(`主密碼錯誤！(剩餘嘗試次數: ${5 - attempts})`);
    }
}

function resetAttempts() {
    sessionStorage.removeItem(ATTEMPTS_KEY);
    sessionStorage.removeItem(LOCKOUT_KEY);
}

// 8. 解鎖與鎖定流程
async function handleUnlock(e) {
    e.preventDefault();
    if (checkLockout()) return;

    const pwdInput = document.getElementById('master-password');
    const pwd = pwdInput.value;
    if (!pwd) return;

    try {
        const rawVault = localStorage.getItem(STORAGE_KEY);
        if (rawVault) {
            const encryptedRecord = JSON.parse(rawVault);
            const decrypted = await decryptPayload(encryptedRecord, pwd);
            state.memoryEntries = decrypted.entries;
            state.aesKey = decrypted.activeKey;
        } else {
            const initSalt = crypto.getRandomValues(new Uint8Array(16));
            const keys = await deriveKeys(pwd, initSalt);
            state.aesKey = keys.aesKey;
            state.memoryEntries = [];
        }

        resetAttempts();
        hideAuthError();
        pwdInput.value = '';

        document.getElementById('vault-auth-card').style.display = 'none';
        document.getElementById('writing-hub').style.display = 'block';

        renderEntries();
        startIdleTimer();
        initDraftRestoration();
    } catch (err) {
        console.error("Auth Failure:", err);
        handleFailedAttempt();
    }
}

function lockVault() {
    state.aesKey = null;
    state.memoryEntries = [];
    clearTimeout(state.idleTimer);
    clearInterval(state.draftInterval);

    document.getElementById('change-pwd-modal').style.display = 'none';
    document.getElementById('writing-hub').style.display = 'none';
    document.getElementById('vault-auth-card').style.display = 'block';
    document.getElementById('saved-list').innerHTML = '';
}

function startIdleTimer() {
    clearTimeout(state.idleTimer);
    state.idleTimer = setTimeout(() => {
        lockVault();
        showAuthError("超過 5 分鐘無操作，保險庫已自動鎖定保護隱私。");
    }, IDLE_TIMEOUT_MS);
}

// 9. 儲存記錄
async function saveEntry() {
    if (!state.aesKey) return;

    let title = "", content = "";
    if (state.activeTab === 'quick') {
        title = document.getElementById('quick-title').value.trim();
        content = document.getElementById('quick-content').value.trim();
    } else if (state.activeTab === 'flip') {
        title = "🧱 逆境轉化";
        content = `挑戰: ${document.getElementById('flip-obstacle').value.trim()}\n轉化: ${document.getElementById('flip-reframe').value.trim()}`;
    } else {
        const date = document.getElementById('future-unlock-date').value;
        title = `✉️ 未來信 (${date || '無指定日期'})`;
        content = document.getElementById('future-content').value.trim();
    }

    if (!content) {
        showToast(state.currentLanguage === 'zh' ? "內容不能為空！" : "Content cannot be empty!", true);
        return;
    }

    const mood = document.getElementById('mood-selector').value;
    const entryObj = {
        id: Date.now(),
        title: title || (state.currentLanguage === 'zh' ? '隨筆' : 'Note'),
        content,
        mood,
        timestamp: new Date().toLocaleString()
    };

    state.memoryEntries.unshift(entryObj);

    const pwdPrompt = prompt(state.currentLanguage === 'zh' ? "請輸入主密碼以確認加密儲存：" : "Re-enter master password to confirm encryption:");
    if (!pwdPrompt) {
        state.memoryEntries.shift();
        showToast(state.currentLanguage === 'zh' ? "取消儲存。" : "Save cancelled.");
        return;
    }

    try {
        const encrypted = await encryptPayload(state.memoryEntries, pwdPrompt);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(encrypted));
        localStorage.removeItem(DRAFT_KEY);

        renderEntries();
        fireConfetti();
        showToast(state.currentLanguage === 'zh' ? "🎉 慶功記錄已加密儲存！" : "🎉 Celebrated entry securely encrypted!");

        document.getElementById('quick-title').value = '';
        document.getElementById('quick-content').value = '';
        document.getElementById('flip-obstacle').value = '';
        document.getElementById('flip-reframe').value = '';
        document.getElementById('future-content').value = '';
    } catch (e) {
        console.error("Encryption Failure:", e);
        state.memoryEntries.shift();
        showToast(state.currentLanguage === 'zh' ? "密碼不符，儲存失敗！" : "Incorrect password. Save failed.", true);
    }
}

// 10. 變更密碼 (Re-encryption)
async function handleChangePassword() {
    const newPwd = document.getElementById('new-password').value;
    const confirmPwd = document.getElementById('confirm-password').value;

    if (!newPwd) {
        showToast(state.currentLanguage === 'zh' ? "請輸入新密碼！" : "Please enter a new password.", true);
        return;
    }
    if (newPwd !== confirmPwd) {
        showToast(state.currentLanguage === 'zh' ? "兩次輸入的新密碼不相符！" : "Passwords do not match!", true);
        return;
    }

    try {
        const encrypted = await encryptPayload(state.memoryEntries, newPwd);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(encrypted));
        
        const salt = new Uint8Array(encrypted.salt);
        const keys = await deriveKeys(newPwd, salt);
        state.aesKey = keys.aesKey;

        document.getElementById('change-pwd-modal').style.display = 'none';
        document.getElementById('new-password').value = '';
        document.getElementById('confirm-password').value = '';

        showToast(state.currentLanguage === 'zh' ? "🎉 主密碼變更成功！所有資料已重新加密。" : "🎉 Password changed and data re-encrypted.");
    } catch (e) {
        console.error("Re-encryption Failure:", e);
        showToast(state.currentLanguage === 'zh' ? "變更失敗，請重試。" : "Failed to change password.", true);
    }
}

// 11. 備份與匯入
async function exportBackup() {
    const rawVault = localStorage.getItem(STORAGE_KEY);
    if (!rawVault) {
        showToast(state.currentLanguage === 'zh' ? "尚無資料可匯出！" : "No data to export!", true);
        return;
    }
    const blob = new Blob([rawVault], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `AlwaysCelebrate_Backup_${new Date().toISOString().slice(0,10)}.alwayscelebrate`;
    a.click();
    URL.revokeObjectURL(url);
}

function importBackup(event) {
    const file = event.target.files[0];
    if (!file) return;

    if (!confirm(state.currentLanguage === 'zh' ? "匯入備份將替換現有資料，確定繼續？" : "Importing will replace current data. Continue?")) {
        event.target.value = '';
        return;
    }

    const reader = new FileReader();
    reader.onload = async (e) => {
        try {
            const importedRecord = JSON.parse(e.target.result);
            if (!importedRecord.salt || !importedRecord.ciphertext) {
                throw new Error("Invalid structure");
            }
            localStorage.setItem(STORAGE_KEY, JSON.stringify(importedRecord));
            showToast(state.currentLanguage === 'zh' ? "備份檔導入成功！請重新解鎖。" : "Backup imported! Please unlock.");
            lockVault();
        } catch (err) {
            console.error("Import Failure:", err);
            showToast(state.currentLanguage === 'zh' ? "❌ 無效或已遭損毀的備份檔！" : "❌ Invalid or corrupted backup file.", true);
        }
    };
    reader.readAsText(file);
}

// 12. 草稿系統
function initDraftRestoration() {
    const draftRaw = localStorage.getItem(DRAFT_KEY);
    if (draftRaw) {
        try {
            const d = JSON.parse(draftRaw);
            if (confirm(state.currentLanguage === 'zh' ? "發現上次未儲存的草稿，是否恢復？" : "Unsaved draft found. Restore?")) {
                if (d.activeTab) switchTab(d.activeTab);
                document.getElementById('quick-title').value = d.quickTitle || '';
                document.getElementById('quick-content').value = d.quickContent || '';
                document.getElementById('flip-obstacle').value = d.flipObstacle || '';
                document.getElementById('flip-reframe').value = d.flipReframe || '';
                document.getElementById('future-unlock-date').value = d.futureUnlockDate || '';
                document.getElementById('future-content').value = d.futureContent || '';
            } else {
                localStorage.removeItem(DRAFT_KEY);
            }
        } catch (e) { localStorage.removeItem(DRAFT_KEY); }
    }

    state.draftInterval = setInterval(() => {
        const draftObj = {
            activeTab: state.activeTab,
            quickTitle: document.getElementById('quick-title').value,
            quickContent: document.getElementById('quick-content').value,
            flipObstacle: document.getElementById('flip-obstacle').value,
            flipReframe: document.getElementById('flip-reframe').value,
            futureUnlockDate: document.getElementById('future-unlock-date').value,
            futureContent: document.getElementById('future-content').value
        };
        const hasContent = Object.values(draftObj).some(v => v && v !== state.activeTab);
        if (hasContent) {
            localStorage.setItem(DRAFT_KEY, JSON.stringify(draftObj));
        } else {
            localStorage.removeItem(DRAFT_KEY);
        }
    }, 5000);
}

// 13. DOM 批次渲染 (DocumentFragment 效能優化)
function renderEntries(data = state.memoryEntries) {
    const listEl = document.getElementById('saved-list');
    listEl.innerHTML = '';
    
    const fragment = document.createDocumentFragment();

    data.forEach(item => {
        const article = document.createElement('article');
        article.className = 'entry-item';
        
        const header = document.createElement('div');
        header.className = 'entry-header';
        header.innerHTML = `<span>${escapeHTML(item.mood)} | ${escapeHTML(item.title)}</span><span>${escapeHTML(item.timestamp)}</span>`;
        
        const content = document.createElement('div');
        content.style.whiteSpace = 'pre-wrap';
        content.textContent = item.content;

        article.appendChild(header);
        article.appendChild(content);
        fragment.appendChild(article);
    });

    listEl.appendChild(fragment);
}

function escapeHTML(str) {
    const p = document.createElement('p');
    p.textContent = str || '';
    return p.innerHTML;
}

