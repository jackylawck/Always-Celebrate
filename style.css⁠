:root {
    --bg-color: #0b0f19;
    --card-bg: #151c2c;
    --card-border: #2c3e50;
    --accent-gold: #f39c12;
    --accent-gold-hover: #d35400;
    --danger-color: #e74c3c;
    --success-color: #2ecc71;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --input-bg: #070a12;
    --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: var(--font-stack);
    line-height: 1.6;
    padding: 20px;
    display: flex;
    justify-content: center;
    min-height: 100vh;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
}

.app-container { max-width: 680px; width: 100%; }

.header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--card-border);
}

.app-title { font-size: 1.6rem; font-weight: 700; color: var(--text-primary); }
.app-slogan { font-size: 0.88rem; color: var(--accent-gold); margin-top: 2px; }

.lang-switch-group {
    display: flex;
    gap: 4px;
    background: rgba(255, 255, 255, 0.05);
    padding: 4px;
    border-radius: 8px;
    border: 1px solid var(--card-border);
}

.lang-btn {
    background: transparent;
    color: var(--text-secondary);
    border: none;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.8rem;
}

.lang-btn.active {
    background: var(--accent-gold);
    color: #ffffff;
    font-weight: 600;
}

.card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 22px;
    margin-bottom: 20px;
}

.guide-box {
    background: rgba(243, 156, 18, 0.08);
    border: 1px solid rgba(243, 156, 18, 0.25);
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 18px;
    font-size: 0.88rem;
}

.guide-box-success {
    background: rgba(46, 204, 113, 0.08);
    border-color: rgba(46, 204, 113, 0.25);
}

.guide-title { font-weight: 600; color: var(--accent-gold); margin-bottom: 8px; font-size: 0.95rem; }
.text-success { color: var(--success-color); }
.guide-list { padding-left: 18px; color: var(--text-secondary); }
.guide-list li { margin-bottom: 6px; }

.mode-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
    background: var(--input-bg);
    padding: 4px;
    border-radius: 10px;
    border: 1px solid var(--card-border);
}

.tab-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.88rem;
    text-align: center;
}

.tab-btn.active {
    background: var(--card-bg);
    color: var(--accent-gold);
    font-weight: 600;
}

input[type="text"], input[type="password"], input[type="date"], input[type="search"], textarea, select {
    width: 100%;
    padding: 12px;
    margin: 6px 0 14px 0;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    background: var(--input-bg);
    color: var(--text-primary);
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
}

input:focus, textarea:focus, select:focus { border-color: var(--accent-gold); }
textarea { resize: vertical; min-height: 100px; }

.strength-bar-wrapper {
    height: 4px;
    background: var(--input-bg);
    border-radius: 2px;
    margin-top: -8px;
    margin-bottom: 12px;
    overflow: hidden;
}

.strength-bar {
    height: 100%;
    width: 0%;
    transition: all 0.3s ease;
}

.error-text {
    color: var(--danger-color);
    font-size: 0.85rem;
    margin-top: -8px;
    margin-bottom: 10px;
}

.btn-primary {
    background: var(--accent-gold);
    color: #ffffff;
    border: none;
    padding: 13px 20px;
    border-radius: 9px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    width: 100%;
    transition: background 0.2s;
}

.btn-primary:hover { background: var(--accent-gold-hover); }

.btn-secondary {
    background: #1e293b;
    color: var(--text-primary);
    border: 1px solid var(--card-border);
    padding: 10px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 500;
    transition: background 0.2s;
}

.btn-secondary:hover { background: #334155; }
.btn-sm { padding: 4px 10px; font-size: 0.8rem; }

.status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--card-border);
}

.status-text { font-size: 0.85rem; color: var(--success-color); font-weight: 600; }
.search-bar { margin-top: 15px; }

.backup-controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--card-border);
}

.backup-controls button { flex: 1; min-width: 140px; }

.modal-box {
    margin-top: 15px;
    padding: 15px;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    background: var(--input-bg);
}

.modal-title { color: var(--accent-gold); margin-bottom: 10px; font-size: 0.95rem; }
.btn-group-row { display: flex; gap: 10px; margin-top: 6px; }
.btn-group-row button { flex: 1; padding: 8px 12px; font-size: 0.9rem; }

.saved-list {
    margin-top: 15px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.entry-item {
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 12px;
}

.entry-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--accent-gold);
    margin-bottom: 6px;
}

#confetti-canvas {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    pointer-events: none;
    z-index: 9999;
}
